          <input id="travellers" name="travellers" type="number" min="1" max="100" value="2" required>
        </div>
        <div class="field full">
          <label for="hotelCategory">Hotel category</label>
          <select id="hotelCategory" name="category">
            <option value="Please recommend">Please recommend</option>
            <option>Deluxe</option>
            <option>Super Deluxe</option>
            <option>Luxury</option>
            <option>Luxury Plus</option>
          </select>
        </div>
        <div class="field full">
          <label for="guestMessage">Preferences / callback time</label>
          <textarea id="guestMessage" name="message" maxlength="1500"
            placeholder="Children’s ages, room requirements, preferred callback time or itinerary changes"></textarea>
        </div>
      </div>

      <p class="form-note">
        This form opens WhatsApp with your enquiry. Review the message and
        press Send there. It does not submit a booking or collect payment.
      </p>
      <button class="btn whatsapp" type="submit" style="width:100%">Continue to WhatsApp →</button>
    </form>
  </dialog>

  <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

  <script>
    (() => {
      "use strict";

      const WHATSAPP_NUMBER = "918278735460";
      const PACKAGE_NAME = "Manali Mountain Holiday by Volvo";
      const dialog = document.getElementById("enquiryDialog");
      const form = document.getElementById("enquiryForm");
      const toast = document.getElementById("toast");
      let enquiryType = "Get a Free Quote";
      let toastTimer;

      document.getElementById("year").textContent = new Date().getFullYear();

      const today = new Date();
      const localDate = [
        today.getFullYear(),
        String(today.getMonth() + 1).padStart(2, "0"),
        String(today.getDate()).padStart(2, "0")
      ].join("-");
      document.getElementById("travelDate").min = localDate;

      function showToast(message) {
        clearTimeout(toastTimer);
        toast.textContent = message;
        toast.hidden = false;
        toastTimer = setTimeout(() => { toast.hidden = true; }, 4500);
      }

      const menuButton = document.querySelector(".menu-toggle");
      const navigation = document.getElementById("navigationLinks");

      menuButton.addEventListener("click", () => {
        const isOpen = navigation.classList.toggle("open");
        menuButton.setAttribute("aria-expanded", String(isOpen));
        menuButton.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");
        menuButton.textContent = isOpen ? "×" : "☰";
      });

      navigation.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => {
          navigation.classList.remove("open");
          menuButton.setAttribute("aria-expanded", "false");
          menuButton.setAttribute("aria-label", "Open navigation");
          menuButton.textContent = "☰";
        });
      });

      document.querySelectorAll("[data-enquiry]").forEach(button => {
        button.addEventListener("click", () => {
          enquiryType = button.dataset.enquiry;
          document.getElementById("enquiryTitle").textContent = enquiryType;

          if (button.dataset.category) {
            document.getElementById("hotelCategory").value = button.dataset.category;
          }

          if (typeof dialog.showModal === "function") {
            dialog.showModal();
          } else {
            window.location.href =
              "https://wa.me/" + WHATSAPP_NUMBER + "?text=" +
              encodeURIComponent("Hello Travspro Holidays, " + enquiryType + " for " + PACKAGE_NAME + ".");
          }
        });
      });

      document.querySelector(".close-dialog").addEventListener("click", () => dialog.close());

      dialog.addEventListener("click", event => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        const outside =
          event.clientX < bounds.left || event.clientX > bounds.right ||
          event.clientY < bounds.top || event.clientY > bounds.bottom;
        if (outside) dialog.close();
      });

      form.addEventListener("submit", event => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        const data = new FormData(form);
        const message = [
          "Hello Travspro Holidays,",
          "",
          "Enquiry: " + enquiryType,
          "Package: " + PACKAGE_NAME,
          "Name: " + String(data.get("name")).trim(),
          "Contact: " + String(data.get("phone")).trim(),
          "Departure date: " + (data.get("date") || "To be decided"),
          "Travellers: " + data.get("travellers"),
          "Hotel category: " + data.get("category"),
          "Preferences: " + (String(data.get("message")).trim() || "Please share package details."),
          "",
          "Please confirm pricing, availability, inclusions, taxes and booking policies."
        ].join("\n");

        window.location.href =
          "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent(message);
      });

      const days = Array.from(document.querySelectorAll("details.day"));
      const toggleDays = document.getElementById("toggleDays");

      function updateDayButton() {
        toggleDays.textContent = days.every(day => day.open) ? "Collapse all days" : "View all days";
      }

      toggleDays.addEventListener("click", () => {
        const shouldOpen = !days.every(day => day.open);
        days.forEach(day => { day.open = shouldOpen; });
        updateDayButton();
      });
      days.forEach(day => day.addEventListener("toggle", updateDayButton));

      function getPackageText() {
        const sections = [
          PACKAGE_NAME,
          "Travspro Holidays",
          "",
          "5-day itinerary | 3 hotel nights | 2 overnight coach journeys",
          "Return arrival in Delhi is normally the morning after Day 5.",
          "Price: On request, per person on twin sharing.",
          ""
        ];

        document.querySelectorAll(".main-content > section").forEach(section => {
          sections.push(section.textContent.replace(/[ \t]+/g, " ").replace(/\n\s*\n/g, "\n").trim());
          sections.push("");
        });

        sections.push("Enquiries: +91 82787 35460");
        return sections.join("\n");
      }

      document.getElementById("downloadItinerary").addEventListener("click", () => {
        const blob = new Blob([getPackageText()], { type: "text/plain;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = "Travspro-Manali-Tour-Itinerary.txt";
        document.body.appendChild(link);
        link.click();
        link.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        showToast("Itinerary downloaded as a text file.");
      });

      let printState = [];
      function preparePrint() {
        printState = Array.from(document.querySelectorAll("details")).map(element => ({
          element,
          open: element.open
        }));
        printState.forEach(item => { item.element.open = true; });
      }
      function restorePrint() {
        printState.forEach(item => { item.element.open = item.open; });
        printState = [];
        updateDayButton();
      }

      window.addEventListener("beforeprint", preparePrint);
      window.addEventListener("afterprint", restorePrint);

      document.getElementById("printItinerary").addEventListener("click", () => {
        window.print();
      });

      function getPublicUrl() {
        return /^https?:$/.test(window.location.protocol) ? window.location.href : "";
      }

      document.getElementById("emailPackage").addEventListener("click", () => {
        const url = getPublicUrl();
        const body = [
          "Hello,",
          "",
          "Please find the Manali Mountain Holiday by Volvo package from Travspro Holidays.",
          "",
          "5-day itinerary, 3 hotel nights and round-trip overnight Volvo travel.",
          "Price and final booking terms are available on request.",
          url ? "\nPackage details: " + url : "",
          "",
          "Enquiries: +91 82787 35460"
        ].join("\n");

        window.location.href =
          "mailto:?subject=" + encodeURIComponent(PACKAGE_NAME + " | Travspro Holidays") +
          "&body=" + encodeURIComponent(body);
      });

      document.getElementById("sharePackage").addEventListener("click", async () => {
        const url = getPublicUrl();
        const text = PACKAGE_NAME + " | Travspro Holidays | Enquiries: +91 82787 35460";

        try {
          if (navigator.share) {
            const shareData = { title: PACKAGE_NAME, text };
            if (url) shareData.url = url;
            await navigator.share(shareData);
          } else if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(url || text);
            showToast(url ? "Package link copied." : "Package details copied.");
          } else {
            window.prompt("Copy these package details:", url || text);
          }
        } catch (error) {
          if (error.name !== "AbortError") {
            showToast("Sharing was unavailable. Use WhatsApp or Email instead.");
          }
        }
      });
    })();
  </script>
</body>
</html>
