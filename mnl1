<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#050816">
  <meta name="description" content="Explore the Manali Mountain Holiday by Volvo with Travspro Holidays. View the Delhi–Manali itinerary, hotel options, inclusions and request a personalized quote.">
  <title>Manali Tour Package by Volvo | Travspro Holidays</title>

  <style>
    /* Save as manali-tour-package.html beside your index.html.
       Existing image paths are preserved: ohom.png and whtbck.jpg.
       Prices and final booking policies must be confirmed before publication. */

    :root {
      --bg: #050816;
      --panel: #0d1429;
      --text: #f4f7ff;
      --muted: #b5bfd5;
      --cyan: #00eaff;
      --purple: #7c5cff;
      --green: #00ffc8;
      --border: rgba(255,255,255,.12);
      --radius: 24px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 125px; }
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      overflow-x: hidden;
      isolation: isolate;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -2;
      pointer-events: none;
      background:
        radial-gradient(circle at 10% 15%, rgba(0,225,255,.14), transparent 28%),
        radial-gradient(circle at 90% 20%, rgba(120,70,255,.16), transparent 30%),
        radial-gradient(circle at 50% 90%, rgba(0,255,180,.08), transparent 30%),
        #050816;
    }
    body::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
      background-size: 55px 55px;
    }

    a { color: inherit; text-decoration: none; }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; }
    img { max-width: 100%; }
    :focus-visible { outline: 3px solid var(--cyan); outline-offset: 5px; }
    .container { width: min(1150px, 92%); margin: auto; }
    .muted { color: var(--muted); }
    .small { font-size: 13px; }
    .accent { color: var(--cyan); }

    /* Navigation */
    .navbar {
      position: fixed;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      width: min(1180px, 94%);
      min-height: 75px;
      padding: 10px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      background: rgba(7,12,30,.92);
      border: 1px solid var(--border);
      border-radius: 50px;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 15px 50px rgba(0,0,0,.35);
      z-index: 100;
    }
    .logo { display: flex; align-items: center; }
    .logo img {
      width: 250px;
      max-height: 90px;
      object-fit: contain;
      display: block;
      filter: drop-shadow(0 0 8px rgba(0,230,255,.25));
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
    }
    .nav-links a {
      display: block;
      padding: 10px 14px;
      color: #d2dbef;
      font-size: 12px;
      font-weight: 700;
      border-radius: 30px;
      transition: .25s;
    }
    .nav-links a:hover, .nav-links .active {
      color: var(--cyan);
      background: rgba(0,225,255,.1);
    }
    .menu-toggle {
      display: none;
      background: transparent;
      color: white;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 7px 12px;
      font-size: 22px;
    }

    /* Hero */
    .hero {
      position: relative;
      overflow: hidden;
      padding: 175px 0 80px;
      min-height: 690px;
    }
    .hero-image {
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        linear-gradient(90deg, rgba(5,8,22,.96), rgba(5,8,22,.68)),
        linear-gradient(180deg, rgba(5,8,22,.1), #050816),
        url("whtbck.jpg") center / cover no-repeat;
      animation: heroZoom 14s ease-in-out infinite alternate;
    }
    .hero::after {
      content: "";
      position: absolute;
      right: -220px;
      top: 80px;
      width: 650px;
      height: 650px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0,225,255,.18), transparent 65%);
      pointer-events: none;
      z-index: -1;
    }
    .breadcrumbs {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      color: #c4cee3;
      font-size: 13px;
      margin-bottom: 30px;
    }
    .breadcrumbs a:hover { color: var(--cyan); }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 8px 17px;
      margin-bottom: 20px;
      border: 1px solid rgba(0,225,255,.3);
      border-radius: 50px;
      background: rgba(0,225,255,.06);
      color: var(--cyan);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .eyebrow::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 12px var(--cyan);
    }
    .hero h1 {
      font-size: clamp(48px, 7.5vw, 92px);
      line-height: 1.04;
      letter-spacing: -3px;
      font-weight: 900;
      max-width: 850px;
    }
    .gradient {
      background: linear-gradient(100deg, #00eaff, #9b83ff, #00ffc8, #00eaff);
      background-size: 300% 300%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: gradientMove 7s ease infinite;
    }
    .hero-description {
      max-width: 690px;
      margin: 24px 0;
      color: #d0d8ea;
      font-size: 17px;
    }
    .trip-tags { display: flex; flex-wrap: wrap; gap: 10px; margin: 25px 0; }
    .tag {
      padding: 8px 14px;
      background: rgba(10,17,38,.85);
      border: 1px solid var(--border);
      border-radius: 50px;
      color: #e1e8f7;
      font-size: 13px;
    }

    /* Buttons */
    .buttons { display: flex; flex-wrap: wrap; gap: 12px; }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 13px 22px;
      border: 1px solid transparent;
      border-radius: 50px;
      color: white;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.5;
      transition: transform .25s, box-shadow .25s, background .25s;
      text-align: center;
    }
    .btn:hover { transform: translateY(-3px); }
    .btn-primary {
      background: linear-gradient(90deg, #007eac, #634dff);
      box-shadow: 0 0 28px rgba(0,217,255,.2);
    }
    .btn-primary:hover { box-shadow: 0 0 40px rgba(0,217,255,.35); }
    .btn-outline {
      background: rgba(255,255,255,.045);
      border-color: rgba(255,255,255,.2);
      color: #e4ebfb;
    }
    .btn-outline:hover { background: rgba(0,225,255,.1); border-color: var(--cyan); }
    .whatsapp {
      background: linear-gradient(90deg, #087b51, #006b49);
      box-shadow: 0 0 25px rgba(0,217,139,.15);
    }

    /* Package layout */
    .quick-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin: 0 auto 40px;
    }
    .quick-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 22px;
      background: linear-gradient(145deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
      border: 1px solid var(--border);
      border-radius: 20px;
    }
    .quick-icon {
      width: 46px;
      height: 46px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      background: rgba(0,225,255,.09);
      border-radius: 14px;
      font-size: 22px;
    }
    .quick-item strong { display: block; }
    .quick-item small { color: var(--muted); }

    .section-nav {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 12px;
      margin-bottom: 35px;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: #0a1022;
    }
    .section-nav a {
      white-space: nowrap;
      padding: 9px 16px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 600;
      color: #c9d3e8;
    }
    .section-nav a:hover { background: rgba(0,225,255,.1); color: var(--cyan); }
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 330px;
      align-items: start;
      gap: 28px;
      padding-bottom: 75px;
    }
    .main-content { min-width: 0; }
    .panel {
      padding: 30px;
      margin-bottom: 25px;
      background: linear-gradient(145deg, rgba(17,26,51,.96), rgba(8,14,31,.96));
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 0 15px 45px rgba(0,0,0,.15);
    }
    .section-label {
      display: block;
      color: var(--cyan);
      font-size: 11px;
      letter-spacing: 2px;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    h2 { font-size: clamp(25px, 3vw, 35px); line-height: 1.2; margin-bottom: 20px; }
    h3 { font-size: 19px; line-height: 1.4; margin-bottom: 10px; }
    .panel p { color: var(--muted); margin-bottom: 14px; }
    .panel p:last-child { margin-bottom: 0; }
    .note {
      padding: 15px 18px;
      border-left: 3px solid var(--cyan);
      border-radius: 0 12px 12px 0;
      background: rgba(0,225,255,.06);
      color: #d3e0f5;
      font-size: 13px;
      margin-top: 18px;
    }
    .highlights { display: grid; gap: 12px; list-style: none; }
    .highlights li { display: flex; gap: 12px; color: #cbd5e9; }
    .highlights li::before { content: "✦"; color: var(--cyan); flex-shrink: 0; }

    /* Itinerary */
    .section-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 22px;
    }
    .section-top h2 { margin: 0; }
    .text-button {
      background: rgba(0,225,255,.08);
      border: 1px solid rgba(0,225,255,.25);
      border-radius: 30px;
      color: var(--cyan);
      padding: 8px 14px;
      font-size: 12px;
      white-space: nowrap;
    }
    details.day {
      margin-bottom: 15px;
      border: 1px solid var(--border);
      border-radius: 18px;
      overflow: hidden;
      background: rgba(255,255,255,.02);
    }
    details.day:last-of-type { margin-bottom: 0; }
    summary { cursor: pointer; }
    .day summary {
      list-style: none;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px;
    }
    summary::-webkit-details-marker { display: none; }
    .day-number {
      flex-shrink: 0;
      width: 54px;
      height: 54px;
      display: grid;
      place-items: center;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(0,225,255,.18), rgba(124,92,255,.22));
      border: 1px solid rgba(0,225,255,.22);
      color: var(--cyan);
      font-weight: 800;
      font-size: 14px;
    }
    .day-title { flex: 1; }
    .day-title small { display: block; color: #9faec9; font-size: 11px; margin-bottom: 3px; }
    .day-title strong { display: block; font-size: 16px; line-height: 1.5; }
    .day summary::after { content: "+"; font-size: 24px; color: var(--cyan); }
    .day[open] summary::after { content: "−"; }
    .day[open] summary { border-bottom: 1px solid var(--border); }
    .day-body { padding: 22px; }
    .day-body p { font-size: 14px; }
    .day-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
    .day-meta span {
      padding: 6px 11px;
      border-radius: 30px;
      font-size: 11px;
      background: rgba(0,255,200,.06);
      border: 1px solid rgba(0,255,200,.16);
      color: #a8efdb;
    }

    /* Inclusions and hotels */
    .list { padding-left: 20px; color: var(--muted); }
    .list li { margin-bottom: 10px; padding-left: 3px; font-size: 14px; }
    .list li::marker { color: var(--cyan); }
    .excluded li::marker { color: #ff9ca9; }
    .hotel-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .hotel-card {
      padding: 22px;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: rgba(255,255,255,.025);
      transition: .3s;
    }
    .hotel-card:hover { transform: translateY(-4px); border-color: rgba(0,225,255,.4); }
    .hotel-card small { color: var(--cyan); font-weight: 700; }
    .hotel-card h3 { font-size: 16px; margin: 10px 0; }
    .hotel-card p { font-size: 12px; }
    .hotel-card .btn { padding: 8px 13px; font-size: 12px; margin-top: 15px; }

    .policy {
      border-bottom: 1px solid var(--border);
      padding: 17px 0;
    }
    .policy:last-child { border-bottom: 0; padding-bottom: 0; }
    .policy summary {
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      font-weight: 700;
      color: #e3ebfa;
    }
    .policy summary::after { content: "+"; color: var(--cyan); font-size: 22px; }
    .policy[open] summary::after { content: "−"; }
    .policy-body { padding-top: 18px; }
    .policy-body h3 { font-size: 15px; margin-top: 18px; }

    /* Booking sidebar */
    .sidebar { position: sticky; top: 115px; }
    .booking-card {
      padding: 28px;
      border: 1px solid rgba(0,225,255,.25);
      border-radius: 26px;
      background: linear-gradient(145deg, #101a35, #0b1024);
      box-shadow: 0 20px 60px rgba(0,0,0,.35), 0 0 35px rgba(0,225,255,.05);
    }
    .price-label { font-size: 11px; color: var(--cyan); letter-spacing: 2px; text-transform: uppercase; }
    .price { font-size: 31px; font-weight: 900; line-height: 1.2; margin: 12px 0; }
    .booking-card p { color: var(--muted); font-size: 13px; }
    .booking-facts { margin: 22px 0; }
    .booking-facts div {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }
    .booking-facts dt { color: var(--muted); }
    .booking-facts dd { text-align: right; font-weight: 600; }
    .booking-actions { display: grid; gap: 11px; }
    .booking-actions .btn { width: 100%; }
    .utility-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: 20px;
    }
    .utility-actions button {
      border: 0;
      background: transparent;
      color: #c4d0e6;
      font-size: 12px;
      padding: 6px;
    }
    .utility-actions button:hover { color: var(--cyan); }
    .sidebar-note {
      margin-top: 18px;
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 18px;
      color: var(--muted);
      font-size: 12px;
      background: rgba(255,255,255,.025);
    }

    /* CTA and footer */
    .cta {
      padding: 65px 30px;
      text-align: center;
      border: 1px solid var(--border);
      border-radius: 30px;
      background: linear-gradient(135deg, rgba(0,225,255,.1), rgba(105,55,255,.14));
      margin-bottom: 70px;
    }
    .cta h2 { font-size: clamp(30px, 5vw, 52px); }
    .cta p { color: var(--muted); max-width: 650px; margin: 0 auto 25px; }
    .cta .buttons { justify-content: center; }
    footer { border-top: 1px solid var(--border); padding: 40px 0 25px; }
    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 35px;
      margin-bottom: 30px;
    }
    .footer-grid h3 { font-size: 16px; }
    .footer-grid p, .footer-grid a { color: var(--muted); font-size: 13px; }
    .footer-links { display: grid; gap: 8px; }
    .footer-links a:hover { color: var(--cyan); }
    .copyright { border-top: 1px solid var(--border); padding-top: 22px; text-align: center; color: #a6b2ca; font-size: 12px; }
    .floating-whatsapp {
      position: fixed;
      bottom: 22px;
      right: 22px;
      z-index: 90;
      padding: 13px 19px;
      border-radius: 50px;
      background: #087b51;
      color: white;
      font-weight: 700;
      font-size: 13px;
      box-shadow: 0 8px 30px rgba(0,0,0,.4);
      border: 1px solid rgba(255,255,255,.2);
    }

    /* Enquiry dialog */
    dialog {
      width: min(540px, 92%);
      max-height: 90vh;
      margin: auto;
      padding: 30px;
      border: 1px solid rgba(0,225,255,.3);
      border-radius: 24px;
      background: #0d1429;
      color: var(--text);
      overflow-y: auto;
      box-shadow: 0 30px 100px rgba(0,0,0,.6);
    }
    dialog::backdrop { background: rgba(0,0,0,.8); backdrop-filter: blur(6px); }
    .dialog-header { display: flex; align-items: start; justify-content: space-between; gap: 15px; }
    .close-dialog {
      background: rgba(255,255,255,.06);
      color: white;
      border: 1px solid var(--border);
      border-radius: 50%;
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      font-size: 22px;
    }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 22px; }
    .field { display: grid; gap: 6px; }
    .field.full { grid-column: 1 / -1; }
    .field label { color: #d6e0f4; font-size: 13px; }
    .field input, .field select, .field textarea {
      width: 100%;
      min-width: 0;
      padding: 11px 12px;
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 10px;
      background: #070d1d;
      color: white;
      color-scheme: dark;
    }
    .field textarea { min-height: 90px; resize: vertical; }
    .form-note { color: var(--muted); font-size: 12px; margin: 17px 0; }
    .toast {
      position: fixed;
      left: 50%;
      bottom: 25px;
      transform: translateX(-50%);
      background: #172342;
      color: white;
      padding: 12px 20px;
      border: 1px solid var(--cyan);
      border-radius: 12px;
      z-index: 200;
      width: max-content;
      max-width: 85%;
      font-size: 13px;
    }
    .toast[hidden] { display: none; }

    /* Content stays visible even if JavaScript is unavailable. */
    @keyframes heroZoom { from { transform: scale(1); } to { transform: scale(1.06); } }
    @keyframes gradientMove {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    @media (max-width: 1000px) {
      .logo img { width: 190px; }
      .nav-links a { padding: 9px 10px; font-size: 11px; }
      .layout { grid-template-columns: minmax(0,1fr) 290px; gap: 20px; }
      .booking-card { padding: 22px; }
      .quick-item { padding: 16px; gap: 10px; }
    }
    @media (max-width: 800px) {
      .layout { grid-template-columns: 1fr; }
      .sidebar { position: static; }
      .quick-strip { grid-template-columns: repeat(2,1fr); }
      .menu-toggle { display: block; }
      .navbar { min-height: 65px; padding: 9px 18px; }
      .logo img { width: 180px; max-height: 65px; }
      .nav-links {
        display: none;
        position: absolute;
        top: calc(100% + 12px);
        left: 0;
        right: 0;
        padding: 15px;
        background: #0b1228;
        border: 1px solid var(--border);
        border-radius: 20px;
        flex-direction: column;
        align-items: stretch;
      }
      .nav-links.open { display: flex; }
      .nav-links a { font-size: 13px; padding: 12px 16px; }
      .hero { padding-top: 145px; min-height: auto; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .footer-brand { grid-column: 1 / -1; }
    }
    @media (max-width: 500px) {
      .hero { padding-bottom: 50px; }
      .hero h1 { font-size: 49px; letter-spacing: -2px; }
      .hero-description { font-size: 15px; }
      .hero .buttons, .cta .buttons { flex-direction: column; }
      .quick-item { padding: 14px 10px; gap: 8px; }
      .quick-icon { width: 34px; height: 38px; font-size: 18px; }
      .quick-item strong { font-size: 13px; }
      .quick-item small { font-size: 11px; }
      .panel { padding: 22px 18px; }
      .section-top { align-items: start; flex-direction: column; }
      .day summary { padding: 16px 12px; gap: 10px; }
      .day-number { width: 43px; height: 46px; font-size: 12px; }
      .day-title strong { font-size: 14px; }
      .day-body { padding: 18px 15px; }
      .hotel-grid, .form-grid { grid-template-columns: 1fr; }
      .field.full { grid-column: auto; }
      .footer-grid { grid-template-columns: 1fr; gap: 25px; }
      .floating-whatsapp { right: 14px; bottom: 14px; font-size: 12px; }
      dialog { padding: 23px 18px; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation: none !important; transition: none !important; }
    }
    @media print {
      body { background: white; color: black; }
      body::before, body::after, .navbar, .hero-image, .hero::after,
      .sidebar, .section-nav, .buttons, .floating-whatsapp, .utility-actions,
      .text-button, .cta, footer, dialog, .toast, .hotel-card .btn { display: none !important; }
      .hero { padding: 20px 0; min-height: auto; }
      .gradient { background: none; color: black; }
      .hero h1 { font-size: 38px; }
      .layout { display: block; }
      .panel, .quick-item, .hotel-card, details.day {
        background: white; color: black; box-shadow: none; border-color: #ccc;
      }
